# ============================================================
# FanControl — .gitignore
# Things that should NOT be in the public GitHub repo.
# ============================================================

# ---------- Build outputs & binaries ----------
# Cross-compiled Linux binary (built with `make` or build.ps1 -Target linux)
/deploy/fanctrl-linux-amd64
# Native binary (build.ps1 -Target native)
/fanctrl
/fanctrl.exe
# Any other built fanctrl binary everywhere
fanctrl
fanctrl.exe
fanctrl-linux-amd64

# ---------- Web build output ----------
# The SPA is generated by Vite from web/; only sources are committed.
# The Go binary embeds web/dist at build time (//go:embed in web/embed.go).
/web/dist/
/web/node_modules/

# ---------- Runtime output & caches ----------
*.log
*.out
*.err
*.pid
# Playwright test artifacts
/web/test-results/
/web/playwright-report/

# ---------- Secrets — never commit ----------
# Config files that reference real passwords/IPs. Only the example template
# (with placeholders) is allowed.
config.yaml
fanctrl.live.yaml
fanctrl.lan.yaml
*.secret
*.pem
*.key
.env
.env.*
# Credential helpers / anything that could carry a password
deploy/askpass.cmd
askpass*

# ---------- Local editor / OS noise ----------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---------- Go ----------
*.test
coverage.*

# ---------- Node ----------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------- Session/tooling directories (not product) ----------
# DSH session skills — remove from tracking and ignore hereafter.
.dsh/

# Keep the example configs (they use placeholders, no real secrets)
!/deploy/fanctrl.example.yaml
